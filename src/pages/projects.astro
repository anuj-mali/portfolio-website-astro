---
import Base from '../layouts/Base.astro';
---

<Base title="Projects — Anuj Mali">
	<main style="min-height:100vh; display:flex; align-items:center; padding:88px 44px;">
		<div style="max-width:860px; margin:0 auto;">
			<div style="display:flex; align-items:center; gap:11px; margin-bottom:10px;">
				<span style="width:9px; height:9px; border-radius:50%; background:#39d3c4; box-shadow:0 0 12px #39d3c4; flex:none;"></span>
				<h1 transition:name="node-projects" style="margin:0; font-size:34px; font-weight:600; letter-spacing:-.5px; color:#eef1f5;">Projects</h1>
			</div>
			<p style="margin:0; font-size:15px; line-height:1.6; color:#828c9b; max-width:560px;">Systems I've designed and shipped — retrieval, orchestration, and the infrastructure around them.</p>
		</div>
	</main>
</Base>
