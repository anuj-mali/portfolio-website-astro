---
import Base from '../layouts/Base.astro';

const ACCENT = '#39d3c4';

const NODES = [
	{ id: 'projects', label: 'Projects', sub: "things I've shipped", x: 53, y: 18, delay: 0.9, href: '/projects', transitionName: 'node-projects' },
	{ id: 'writing', label: 'Writing', sub: 'notes & essays', x: 81, y: 37, delay: 1.0, href: '/writing', transitionName: 'node-writing' },
	{ id: 'uses', label: 'Uses', sub: 'tools & setup', x: 72, y: 74, delay: 1.1, href: '/uses', transitionName: 'node-uses' },
	{ id: 'now', label: 'Now', sub: "what I'm doing", x: 45, y: 80, delay: 1.2, href: '/now', transitionName: 'node-now' },
	{ id: 'contact', label: 'Contact', sub: 'say hello', x: 13, y: 24, delay: 1.3, href: 'mailto:me@anujmali.com.np', transitionName: null },
];

const LINE_ORDER = [
	{ id: 'contact', delay: 0.18 },
	{ id: 'projects', delay: 0.30 },
	{ id: 'writing', delay: 0.42 },
	{ id: 'uses', delay: 0.54 },
	{ id: 'now', delay: 0.66 },
];

const CENTER = { x: 31, y: 50 };
---

<Base title="Anuj Mali — AI Engineer">
	<main
		id="stage"
		style={`position:fixed; inset:0; overflow:hidden; background:#07090d; font-family:ui-sans-serif, system-ui, -apple-system, "Segoe UI", Roboto, Helvetica, Arial, sans-serif; color:#e9edf3; --accent:${ACCENT};`}
	>
		<!-- nebula wash — deep teal, off-center left -->
		<div style="position:absolute; width:900px; height:680px; left:-6%; top:8%; border-radius:50%; background:radial-gradient(ellipse at 50% 50%, rgba(28,185,165,0.10) 0%, rgba(14,145,132,0.05) 38%, transparent 68%); filter:blur(80px); pointer-events:none; z-index:0;"></div>
		<!-- nebula wash — dark purple, off-center right -->
		<div style="position:absolute; width:820px; height:620px; right:-4%; top:28%; border-radius:50%; background:radial-gradient(ellipse at 50% 50%, rgba(115,58,210,0.09) 0%, rgba(82,38,168,0.04) 38%, transparent 68%); filter:blur(90px); pointer-events:none; z-index:0;"></div>

		<!-- distant star layer -->
		<div id="stars-distant" style="position:absolute; left:-20px; top:-20px; right:-20px; bottom:-20px; pointer-events:none; z-index:0; will-change:transform;">
			<svg id="egg-svg-distant" style="position:absolute; left:0; top:0; width:100%; height:100%; overflow:visible; pointer-events:none;"></svg>
		</div>

		<!-- mid star layer -->
		<div id="stars-mid" style="position:absolute; left:-20px; top:-20px; right:-20px; bottom:-20px; pointer-events:none; z-index:0; will-change:transform;">
			<svg id="egg-svg-mid" style="position:absolute; left:0; top:0; width:100%; height:100%; overflow:visible; pointer-events:none;"></svg>
		</div>

		<!-- near star layer -->
		<div id="stars-near" style="position:absolute; left:-20px; top:-20px; right:-20px; bottom:-20px; pointer-events:none; z-index:0; will-change:transform;">
			<svg id="egg-svg-near" style="position:absolute; left:0; top:0; width:100%; height:100%; overflow:visible; pointer-events:none;"></svg>
		</div>

		<!-- vignette -->
		<div style="position:absolute; inset:0; background:radial-gradient(ellipse 84% 80% at 50% 48%, transparent 28%, rgba(5,7,11,0.52) 62%, rgba(4,6,9,0.90) 100%); pointer-events:none; z-index:1;"></div>

		<!-- horizon glow -->
		<div style="position:absolute; bottom:0; left:0; right:0; height:200px; background:radial-gradient(ellipse 72% 100% at 50% 100%, rgba(28,185,165,0.07) 0%, transparent 68%); pointer-events:none; z-index:1;"></div>

		<!-- constellation layer -->
		<div id="constellation" style="position:absolute; inset:0; pointer-events:none; will-change:transform; z-index:2;">

			<svg id="lines-svg" style="position:absolute; inset:0; width:100%; height:100%; overflow:visible; pointer-events:none; z-index:1;">
				{LINE_ORDER.map((ln) => (
					<line
						id={`line-${ln.id}`}
						data-delay={ln.delay}
						x1={`${CENTER.x}%`} y1={`${CENTER.y}%`}
						x2={`${NODES.find((n) => n.id === ln.id)!.x}%`} y2={`${NODES.find((n) => n.id === ln.id)!.y}%`}
						pathLength="1"
						style={`stroke:rgba(122,140,168,0.22); stroke-width:1; stroke-dasharray:1; stroke-dashoffset:1; transition:stroke .25s ease, stroke-width .25s ease; animation:draw 1.1s cubic-bezier(.4,.6,.2,1) ${ln.delay}s forwards;`}
					/>
				))}
			</svg>

			{NODES.map((n) => (
				<div data-travel-dot={n.id} style="position:absolute; left:-100px; top:-100px; width:5px; height:5px; border-radius:50%; background:var(--accent); box-shadow:0 0 7px var(--accent), 0 0 14px color-mix(in srgb, var(--accent) 45%, transparent); pointer-events:none; z-index:2; transform:translate(-50%,-50%); opacity:0;"></div>
			))}

			<!-- center node -->
			<div style="position:absolute; left:31%; top:50%; transform:translate(-50%,-50%); z-index:3;">
				<div style="display:flex; flex-direction:row; align-items:center; text-align:left; gap:24px; animation:coreIn .8s ease .25s backwards;">
					<div style="position:relative; width:20px; height:20px; flex:none;" data-node-dot="center">
						<div style="position:absolute; inset:-18px; border-radius:50%; background:radial-gradient(circle, var(--accent), transparent 70%); opacity:.5; animation:pulse 3.6s ease-in-out infinite;"></div>
						<div style="position:absolute; inset:-9px; border-radius:50%; border:1px solid color-mix(in srgb, var(--accent) 32%, transparent);"></div>
						<div style="position:relative; width:20px; height:20px; border-radius:50%; background:var(--accent); box-shadow:0 0 14px var(--accent), 0 0 38px color-mix(in srgb, var(--accent) 50%, transparent);"></div>
					</div>
					<div style="max-width:480px;">
						<div style="font-size:10.5px; font-weight:500; letter-spacing:3px; text-transform:uppercase; color:color-mix(in srgb, var(--accent) 38%, #5a6473); margin-bottom:11px;">AI ENGINEER</div>
						<div style="font-size:30px; font-weight:600; letter-spacing:-.4px; color:#f0f3f7; line-height:1.1;">Anuj Mali</div>
						<div style="font-size:14.5px; font-weight:400; line-height:1.55; color:#8b95a4; margin-top:13px; text-wrap:pretty;">I build production RAG pipelines and LLM infrastructure for companies that need AI to actually work in production.</div>
					</div>
				</div>
			</div>

			<!-- branch nodes -->
			{NODES.map((n) => (
				<a
					href={n.href}
					data-node-id={n.id}
					transition:name={n.transitionName ?? undefined}
					style={`position:absolute; left:${n.x}%; top:${n.y}%; transform:translate(-50%,-50%); z-index:2; text-decoration:none; pointer-events:auto;`}
				>
					<div
						class="node-inner"
						style={`display:flex; flex-direction:column; align-items:center; gap:11px; cursor:pointer; user-select:none; transition:transform .28s ease; animation:nodeIn .55s ease ${n.delay}s backwards; --halo:.38; --dg:9px;`}
					>
						<div style="position:relative; width:13px; height:13px;" data-node-dot={n.id}>
							<div style="position:absolute; inset:-10px; border-radius:50%; background:radial-gradient(circle, var(--accent), transparent 70%); opacity:var(--halo,.38); transition:opacity .28s ease; animation:pulse 3.4s ease-in-out infinite;"></div>
							<div style="position:relative; width:13px; height:13px; border-radius:50%; background:var(--accent); box-shadow:0 0 var(--dg,9px) var(--accent), 0 0 calc(var(--dg,9px)*2.4) color-mix(in srgb, var(--accent) 42%, transparent); transition:box-shadow .28s ease;"></div>
						</div>
						<div style="text-align:center;">
							<div style="font-size:15px; font-weight:560; letter-spacing:.2px; color:#e8edf3;">{n.label}</div>
							<div style="font-size:11.5px; color:#727c8b; margin-top:3px; letter-spacing:.3px;">{n.sub}</div>
						</div>
					</div>
				</a>
			))}
		</div>

		<!-- bottom instrument bar -->
		<div style="position:absolute; left:0; right:0; bottom:0; z-index:6; height:60px; display:flex; align-items:center; justify-content:space-between; padding:0 26px; border-top:1px solid rgba(255,255,255,.055);">
			<div style="flex:1 1 0; display:flex; align-items:center;">
				<div style="font-size:12px; letter-spacing:.3px; color:#5e6877;">Kathmandu &middot; open to remote</div>
			</div>

			<div style="flex:none; display:flex; align-items:center; gap:12px; font-size:11px; letter-spacing:.5px; color:#5e6877;">
				<a href="https://github.com/anujmali" target="_blank" rel="noopener" aria-label="GitHub" class="icon-link" style="display:flex; align-items:center; opacity:.5; transition:opacity .2s ease; line-height:0;">
					<svg width="15" height="15" viewBox="0 0 16 16" fill="currentColor" style="color:#c7ced9;">
						<path fill-rule="evenodd" clip-rule="evenodd" d="M8 0C3.58 0 0 3.66 0 8.18c0 3.61 2.29 6.67 5.47 7.75.4.08.55-.18.55-.4 0-.19-.01-.83-.01-1.51-2.01.38-2.53-.5-2.69-.96-.09-.24-.48-.96-.82-1.16-.28-.15-.68-.53-.01-.54.63-.01 1.08.59 1.23.83.72 1.24 1.87.89 2.33.68.07-.53.28-.89.51-1.1-1.78-.2-3.64-.91-3.64-4.02 0-.89.31-1.62.82-2.19-.08-.2-.36-1.04.08-2.16 0 0 .67-.22 2.2.84a7.4 7.4 0 0 1 4 0c1.53-1.06 2.2-.84 2.2-.84.44 1.12.16 1.96.08 2.16.51.57.82 1.29.82 2.19 0 3.12-1.87 3.82-3.65 4.02.29.26.54.76.54 1.53 0 1.11-.01 2-.01 2.27 0 .22.15.48.55.4A8.18 8.18 0 0 0 16 8.18C16 3.66 12.42 0 8 0Z"></path>
					</svg>
				</a>
				<span style="opacity:.3;">&middot;</span>
				<a href="https://linkedin.com/in/anujmali" target="_blank" rel="noopener" aria-label="LinkedIn" class="icon-link" style="display:flex; align-items:center; opacity:.5; transition:opacity .2s ease; line-height:0;">
					<svg width="14" height="14" viewBox="0 0 16 16" fill="currentColor" style="color:#c7ced9;">
						<path d="M14.82 0H1.18C.53 0 0 .52 0 1.16v13.68C0 15.48.53 16 1.18 16h13.64c.65 0 1.18-.52 1.18-1.16V1.16C16 .52 15.47 0 14.82 0ZM4.75 13.63H2.37V6h2.38v7.63ZM3.56 4.96c-.76 0-1.38-.62-1.38-1.38 0-.76.62-1.38 1.38-1.38.76 0 1.38.62 1.38 1.38 0 .76-.62 1.38-1.38 1.38Zm10.07 8.67h-2.37V9.9c0-.86-.02-1.97-1.2-1.97-1.2 0-1.39.94-1.39 1.9v3.8H6.3V6h2.28v1.04h.03c.32-.6 1.09-1.23 2.24-1.23 2.4 0 2.84 1.58 2.84 3.63v4.19Z"></path>
					</svg>
				</a>
				<span style="opacity:.3;">&middot;</span>
				<a href="#" aria-label="Download CV" class="icon-link" style="opacity:.5; transition:opacity .2s ease; color:#c7ced9; text-decoration:none;">CV &darr;</a>
			</div>

			<div style="flex:1 1 0; display:flex; align-items:center; justify-content:flex-end; gap:9px; font-family:'Courier New', ui-monospace, monospace; font-size:11px; letter-spacing:.6px; color:#3a4a58;">
				<svg width="13" height="13" viewBox="0 0 13 13" fill="none">
					<circle cx="6.5" cy="6.5" r="5" stroke="#3a4a58" stroke-width="1"></circle>
					<line x1="6.5" y1="1" x2="6.5" y2="12" stroke="#3a4a58" stroke-width="1"></line>
					<line x1="1" y1="6.5" x2="12" y2="6.5" stroke="#3a4a58" stroke-width="1"></line>
					<circle cx="6.5" cy="6.5" r="1.2" fill="#3a4a58"></circle>
				</svg>
				27.7172&#176; N &nbsp; 85.3240&#176; E
			</div>
		</div>
	</main>

	<style>
		.icon-link:hover { opacity: 1; }
		.node-inner:hover { transform: translateY(-3px); }
	</style>

	<script>
		const stage = document.getElementById('stage')!;
		const distantEl = document.getElementById('stars-distant')!;
		const midEl = document.getElementById('stars-mid')!;
		const nearEl = document.getElementById('stars-near')!;
		const constellationEl = document.getElementById('constellation')!;

		const NODE_IDS = ['projects', 'writing', 'uses', 'now', 'contact'];

		let dotPositions: Record<string, { x: number; y: number }> = {};

		function measureDots() {
			const prevTransform = constellationEl.style.transform;
			constellationEl.style.transform = 'none';
			const els = stage.querySelectorAll('[data-node-dot]');
			const dp: Record<string, { x: number; y: number }> = {};
			els.forEach((el) => {
				const id = el.getAttribute('data-node-dot')!;
				const r = el.getBoundingClientRect();
				dp[id] = { x: r.left + r.width / 2, y: r.top + r.height / 2 };
			});
			constellationEl.style.transform = prevTransform || '';
			dotPositions = dp;
			drawLines();
		}

		function drawLines() {
			if (!dotPositions.center) return;
			NODE_IDS.forEach((id) => {
				const line = document.getElementById(`line-${id}`);
				if (!line || !dotPositions[id]) return;
				line.setAttribute('x1', String(dotPositions.center.x));
				line.setAttribute('y1', String(dotPositions.center.y));
				line.setAttribute('x2', String(dotPositions[id].x));
				line.setAttribute('y2', String(dotPositions[id].y));
			});
		}

		// --- star field: seeded RNG so the layout is stable across reloads ---
		let seed = 77;
		const rnd = () => {
			seed = (seed * 1664525 + 1013904223) >>> 0;
			return seed / 4294967296;
		};

		function makeStar(top: number, left: number, size: number, extraStyle: string) {
			const span = document.createElement('span');
			span.style.cssText = `position:absolute; top:${top}%; left:${left}%; width:${size}px; height:${size}px; border-radius:50%; pointer-events:none; ${extraStyle}`;
			return span;
		}

		function buildStars() {
			for (let i = 0; i < 90; i++) {
				const t = rnd() * 100, l = rnd() * 100;
				const sz = 0.5 + rnd() * 0.6;
				const op = 0.05 + rnd() * 0.12;
				distantEl.appendChild(makeStar(t, l, sz, `background:#b8c4d4; opacity:${op};`));
			}
			const drifts = ['drift1', 'drift2', 'drift3', 'drift4'];
			for (let i = 0; i < 35; i++) {
				const t = rnd() * 100, l = rnd() * 100;
				const sz = 1 + rnd() * 0.6;
				const op = 0.22 + rnd() * 0.18;
				const dur = 28 + rnd() * 22;
				const del = -(rnd() * 20);
				const anim = drifts[Math.floor(rnd() * 4)];
				midEl.appendChild(makeStar(t, l, sz, `background:#c0cbdb; opacity:${op}; animation:${anim} ${dur.toFixed(1)}s ease-in-out ${del.toFixed(1)}s infinite;`));
			}
			for (let i = 0; i < 10; i++) {
				const t = 5 + rnd() * 88, l = 5 + rnd() * 88;
				const sz = 1.4 + rnd() * 1.1;
				const op = 0.52 + rnd() * 0.22;
				const dur = 3 + rnd() * 5;
				const del = -(rnd() * 8);
				nearEl.appendChild(makeStar(t, l, sz, `background:#d4dce9; --star-op:${op.toFixed(2)}; animation:twinkle ${dur.toFixed(1)}s ease-in-out ${del.toFixed(1)}s infinite; filter:blur(.2px); box-shadow:0 0 ${(sz * 2).toFixed(1)}px rgba(200,218,240,0.35);`));
			}
		}

		// --- easter-egg hidden constellations (Git, Python, Linux, Docker, Ghost) ---
		type EggDef = { id: string; label: string; cx: number; cy: number; depth: 'distant' | 'mid' | 'near'; stars: [number, number][]; edges: [number, number][] };

		const EGGS: EggDef[] = [
			{ id: 'git', label: 'git', cx: 92, cy: 58, depth: 'mid',
				stars: [[0,40],[0,22],[0,4],[-16,-16],[-16,-34],[16,-16],[16,-34]],
				edges: [[0,1],[1,2],[2,3],[3,4],[2,5],[5,6]] },
			{ id: 'python', label: 'python', cx: 5, cy: 68, depth: 'near',
				stars: [[-22,-30],[-8,-12],[8,8],[22,26],[22,-30],[8,-12],[-8,8],[-22,26]],
				edges: [[0,1],[1,2],[2,3],[4,5],[5,6],[6,7]] },
			{ id: 'linux', label: 'linux', cx: 10, cy: 88, depth: 'distant',
				stars: [[0,-36],[-9,-26],[9,-26],[-20,-8],[20,-8],[-16,8],[16,8],[-8,24],[8,24]],
				edges: [[0,1],[0,2],[1,2],[1,3],[2,4],[3,5],[4,6],[5,7],[6,8],[7,8]] },
			{ id: 'docker', label: 'docker', cx: 83, cy: 85, depth: 'mid',
				stars: [[-35,5],[-20,2],[-5,-2],[10,1],[28,8],[-15,-18],[-2,-21],[11,-17]],
				edges: [[0,1],[1,2],[2,3],[3,4],[1,4],[2,6],[5,6],[6,7],[3,7]] },
			{ id: 'ghost', label: 'ghost', cx: 75, cy: 10, depth: 'near',
				stars: [[0,-40],[-10,-22],[10,-22],[-38,-12],[-65,5],[-45,26],[38,-12],[65,5],[45,26],[-14,46],[0,54],[14,46]],
				edges: [[0,1],[0,2],[1,3],[3,4],[4,5],[5,1],[2,6],[6,7],[7,8],[8,2],[1,9],[2,11],[5,9],[8,11],[9,10],[10,11]] },
		];

		const TEAL = 'rgba(32,185,165,0.4)';
		const SFILL = 'rgba(185,200,220,0.42)';
		const LAYER_OFFSET = 20;
		const PARALLAX_MULT: Record<string, number> = { distant: 3, mid: 9, near: 19 };
		const SVG_FOR: Record<string, SVGSVGElement> = {
			distant: document.getElementById('egg-svg-distant') as unknown as SVGSVGElement,
			mid: document.getElementById('egg-svg-mid') as unknown as SVGSVGElement,
			near: document.getElementById('egg-svg-near') as unknown as SVGSVGElement,
		};

		let eggConstellations: { id: string; depth: string; stars: [number, number][]; absX: number; absY: number; revealEl: SVGGElement }[] = [];

		function buildEasterEggs() {
			Object.values(SVG_FOR).forEach((svg) => { svg.innerHTML = ''; });
			const W = window.innerWidth;
			const H = window.innerHeight;

			eggConstellations = EGGS.map((c) => {
				const absX = (W * c.cx) / 100;
				const absY = (H * c.cy) / 100;
				const svg = SVG_FOR[c.depth];

				const g = document.createElementNS('http://www.w3.org/2000/svg', 'g');
				g.setAttribute('transform', `translate(${absX + LAYER_OFFSET},${absY + LAYER_OFFSET})`);

				const gStars = document.createElementNS('http://www.w3.org/2000/svg', 'g');
				c.stars.forEach((s) => {
					const circle = document.createElementNS('http://www.w3.org/2000/svg', 'circle');
					circle.setAttribute('cx', String(s[0]));
					circle.setAttribute('cy', String(s[1]));
					circle.setAttribute('r', '1.3');
					circle.setAttribute('fill', SFILL);
					gStars.appendChild(circle);
				});

				const gReveal = document.createElementNS('http://www.w3.org/2000/svg', 'g') as SVGGElement;
				gReveal.style.opacity = '0';
				gReveal.style.transition = 'opacity 0.3s ease';

				c.edges.forEach((e) => {
					const line = document.createElementNS('http://www.w3.org/2000/svg', 'line');
					line.setAttribute('x1', String(c.stars[e[0]][0]));
					line.setAttribute('y1', String(c.stars[e[0]][1]));
					line.setAttribute('x2', String(c.stars[e[1]][0]));
					line.setAttribute('y2', String(c.stars[e[1]][1]));
					line.setAttribute('stroke', TEAL);
					line.setAttribute('stroke-width', '1');
					line.setAttribute('stroke-linecap', 'round');
					gReveal.appendChild(line);
				});

				const maxY = Math.max(...c.stars.map((s) => s[1]));
				const centroidX = c.stars.reduce((s, st) => s + st[0], 0) / c.stars.length;
				const text = document.createElementNS('http://www.w3.org/2000/svg', 'text');
				text.setAttribute('x', String(centroidX));
				text.setAttribute('y', String(maxY + 17));
				text.setAttribute('text-anchor', 'middle');
				text.setAttribute('fill', TEAL);
				text.setAttribute('font-size', '10');
				text.setAttribute('font-family', 'ui-sans-serif, system-ui, -apple-system, "Segoe UI", Roboto, Helvetica, Arial, sans-serif');
				text.setAttribute('letter-spacing', '1.5');
				text.textContent = c.label;
				gReveal.appendChild(text);

				g.appendChild(gStars);
				g.appendChild(gReveal);
				svg.appendChild(g);

				return { id: c.id, depth: c.depth, stars: c.stars, absX, absY, revealEl: gReveal };
			});
		}

		function updateEggProximity(mx: number, my: number) {
			eggConstellations.forEach((c) => {
				const m = PARALLAX_MULT[c.depth] || 0;
				const shiftX = parallaxCurrent.dx * m;
				const shiftY = parallaxCurrent.dy * m;
				const inRange = c.stars.some((s) => {
					const dx = mx - (c.absX + s[0] + shiftX);
					const dy = my - (c.absY + s[1] + shiftY);
					return dx * dx + dy * dy < 3600;
				});
				c.revealEl.style.opacity = inRange ? '1' : '0';
			});
		}

		// --- travel dots along each line ---
		const PERIOD = 5400;
		const PHASES: Record<string, number> = { projects: 0, writing: 0.22, uses: 0.44, now: 0.66, contact: 0.88 };

		let startTime: number | null = null;
		const parallaxTarget = { dx: 0, dy: 0 };
		const parallaxCurrent = { dx: 0, dy: 0 };

		function loop(ts: number) {
			if (!startTime) startTime = ts;
			const elapsed = ts - startTime;
			const lerp = 0.04;
			parallaxCurrent.dx += (parallaxTarget.dx - parallaxCurrent.dx) * lerp;
			parallaxCurrent.dy += (parallaxTarget.dy - parallaxCurrent.dy) * lerp;
			const pdx = parallaxCurrent.dx;
			const pdy = parallaxCurrent.dy;

			distantEl.style.transform = `translate(${(pdx * 3).toFixed(2)}px,${(pdy * 3).toFixed(2)}px)`;
			midEl.style.transform = `translate(${(pdx * 9).toFixed(2)}px,${(pdy * 9).toFixed(2)}px)`;
			nearEl.style.transform = `translate(${(pdx * 19).toFixed(2)}px,${(pdy * 19).toFixed(2)}px)`;
			constellationEl.style.transform = `translate(${(pdx * 8).toFixed(2)}px,${(pdy * 8).toFixed(2)}px)`;

			if (dotPositions.center) {
				NODE_IDS.forEach((id) => {
					const el = document.querySelector(`[data-travel-dot="${id}"]`) as HTMLElement | null;
					if (!el || !dotPositions[id]) return;
					const raw = ((elapsed + PHASES[id] * PERIOD) % PERIOD) / PERIOD;
					const s = raw * raw * (3 - 2 * raw);
					const x = dotPositions.center.x + (dotPositions[id].x - dotPositions.center.x) * s;
					const y = dotPositions.center.y + (dotPositions[id].y - dotPositions.center.y) * s;
					el.style.left = `${x}px`;
					el.style.top = `${y}px`;
					let op = 0.52;
					if (raw < 0.07) op = 0.52 * (raw / 0.07);
					if (raw > 0.88) op = 0.52 * ((1 - raw) / 0.12);
					el.style.opacity = String(op);
				});
			}
			requestAnimationFrame(loop);
		}

		// --- node hover: brighten node + connecting line ---
		document.querySelectorAll<HTMLElement>('[data-node-id]').forEach((a) => {
			const id = a.getAttribute('data-node-id')!;
			const inner = a.querySelector('.node-inner') as HTMLElement | null;
			const line = document.getElementById(`line-${id}`);
			a.addEventListener('mouseenter', () => {
				if (inner) {
					inner.style.setProperty('--halo', '0.9');
					inner.style.setProperty('--dg', '16px');
				}
				if (line) {
					line.style.stroke = 'var(--accent)';
					line.style.strokeWidth = '1.5';
				}
			});
			a.addEventListener('mouseleave', () => {
				if (inner) {
					inner.style.setProperty('--halo', '.38');
					inner.style.setProperty('--dg', '9px');
				}
				if (line) {
					line.style.stroke = 'rgba(122,140,168,0.22)';
					line.style.strokeWidth = '1';
				}
			});
		});

		buildStars();
		requestAnimationFrame(() => {
			measureDots();
			buildEasterEggs();
			requestAnimationFrame(loop);
		});

		window.addEventListener('resize', () => {
			measureDots();
			buildEasterEggs();
		});

		window.addEventListener('mousemove', (e) => {
			const cx = window.innerWidth / 2;
			const cy = window.innerHeight / 2;
			parallaxTarget.dx = (e.clientX - cx) / cx;
			parallaxTarget.dy = (e.clientY - cy) / cy;
			updateEggProximity(e.clientX, e.clientY);
		});
	</script>
</Base>
