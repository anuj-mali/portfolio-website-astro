---
import Base from '../layouts/Base.astro';
---

<Base title="Now — Anuj Mali">
	<main style="min-height:100vh; display:flex; align-items:center; padding:88px 44px;">
		<div style="max-width:860px; margin:0 auto;">
			<div style="display:flex; align-items:center; gap:11px; margin-bottom:10px;">
				<span style="width:9px; height:9px; border-radius:50%; background:#39d3c4; box-shadow:0 0 12px #39d3c4; flex:none;"></span>
				<h1 transition:name="node-now" style="margin:0; font-size:34px; font-weight:600; letter-spacing:-.5px; color:#eef1f5;">Now</h1>
			</div>
			<p style="margin:0 0 8px; font-size:11.5px; letter-spacing:.5px; text-transform:uppercase; color:#5f6a79;">Updated July 2026</p>
			<p style="margin:0; font-size:16px; line-height:1.7; color:#b6bdc8; max-width:600px;">What I'm building, reading, and focused on right now.</p>
		</div>
	</main>
</Base>
